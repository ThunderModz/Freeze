-- Button creator
local function createToggleButton(name, icon, order)
	local container = Instance.new("Frame")
	container.Name = "Button_" .. order
	container.Size = UDim2.new(1, 0, 0, 52)
	container.BackgroundColor3 = Color3.fromRGB(10, 30, 55)
	container.BorderSizePixel = 0
	container.LayoutOrder = order
	container.Parent = content

	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(30, 100, 180)
	stroke.Transparency = 0.4
	stroke.Parent = container

	local iconLabel = Instance.new("TextLabel")
	iconLabel.Size = UDim2.fromOffset(32, 32)
	iconLabel.Position = UDim2.new(0, 10, 0.5, -16)
	iconLabel.BackgroundColor3 = Color3.fromRGB(20, 80, 150)
	iconLabel.Text = icon
	iconLabel.TextColor3 = Color3.fromRGB(170, 220, 255)
	iconLabel.TextSize = 19
	iconLabel.Font = Enum.Font.GothamBold
	iconLabel.Parent = container
	Instance.new("UICorner", iconLabel).CornerRadius = UDim.new(0, 7)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -110, 1, 0)
	nameLabel.Position = UDim2.fromOffset(52, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = name
	nameLabel.TextColor3 = Color3.fromRGB(210, 230, 255)
	nameLabel.TextSize = isMobile and 11 or 13
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextWrapped = true
	nameLabel.Parent = container

	local track = Instance.new("Frame")
	track.Size = UDim2.fromOffset(42, 23)
	track.Position = UDim2.new(1, -52, 0.5, -11)
	track.BackgroundColor3 = Color3.fromRGB(15, 35, 60)
	track.Parent = container
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(17, 17)
	knob.Position = UDim2.new(0, 3, 0.5, -8)
	knob.BackgroundColor3 = Color3.fromRGB(130, 180, 220)
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local clickButton = Instance.new("TextButton")
	clickButton.Size = UDim2.fromScale(1, 1)
	clickButton.BackgroundTransparency = 1
	clickButton.Text = ""
	clickButton.Parent = container

	local enabled = false

	clickButton.Activated:Connect(function()
		enabled = not enabled

		TweenService:Create(knob, TweenInfo.new(0.2), {
			Position = enabled
				and UDim2.new(1, -20, 0.5, -8)
				or UDim2.new(0, 3, 0.5, -8),
			BackgroundColor3 = enabled
				and Color3.fromRGB(200, 235, 255)
				or Color3.fromRGB(130, 180, 220)
		}):Play()

		TweenService:Create(track, TweenInfo.new(0.2), {
			BackgroundColor3 = enabled
				and Color3.fromRGB(20, 110, 220)
				or Color3.fromRGB(15, 35, 60)
		}):Play()

		stroke.Color = enabled
			and Color3.fromRGB(50, 160, 255)
			or Color3.fromRGB(30, 100, 180)

		print("[ThunderModz] " .. name .. ": "
			.. (enabled and "ON" or "OFF"))
	end)
end

